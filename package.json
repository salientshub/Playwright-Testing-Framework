{
  "name": "playwright-demoqa",
  "version": "1.0.0",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "report": "npx playwright show-report",
    "test:sanity": "npx playwright test --grep @sanity",
    "test:regression": "npx playwright test --grep @regression",
    "test:all": "npx playwright test --grep \"@sanity|@regression\"",
    "test:elements": "npx playwright test --grep @elements",
    "test:forms": "npx playwright test --grep @forms",
    "test:afw": "npx playwright test --grep @afw",
    "test:widgets": "npx playwright test --grep @widgets",
    "test:interactions": "npx playwright test --grep @interactions",
    "test:bookstore": "npx playwright test --grep @bookstore",
    "allure:clean": "npx rimraf allure-results allure-report",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:allure": "npm run allure:clean && npm run test && npm run allure:report",
    "test:sanity:allure": "npm run allure:clean && npm run test:sanity && npm run allure:report",
    "test:regression:allure": "npm run allure:clean && npm run test:regression && npm run allure:report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@types/node": "^22.0.0",
    "allure": "^3.7.0",
    "allure-js-commons": "^3.7.2",
    "allure-playwright": "^3.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.0.0"
  }
}
